---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Button,
  CodeBlock,
  Facts,
  Faq,
  Features,
  Hero,
  Install,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
import { url } from '@casoon/pages-theme/url';
// Animated SVG built with castwright from site/captures/lint.terminal.yaml (real runs, see capture.sh).
import lintSvg from '../../captures/lint.svg?url';
import Diagram from '../components/Diagram.astro';

const usage = `cargo install knowledge-lint
knowledge-lint lint   # checks ./knowledge`;

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    title="Keep your knowledge base honest."
    lead="Markdown notes drift quietly: a folder nobody declared, a link to a deleted entry, an API key pasted into a note. knowledge-lint checks the whole knowledge base against the rules in your _types.yml and fails the run when something is off – locally or in CI."
  >
    <Install
      commands={[
        { label: 'crates.io', command: 'cargo install knowledge-lint' },
        { label: 'git', command: 'cargo install --git https://github.com/casoon/knowledge-lint' },
      ]}
    />
    <Badges>
      <Badge>Free · MIT</Badge>
      <Badge>v{config.version}</Badge>
      <Badge tone="accent">single binary</Badge>
      <Badge>local and CI</Badge>
    </Badges>
    <img
      slot="output"
      class="terminal-demo"
      src={lintSvg}
      width="511.2"
      height="278"
      alt="Terminal: knowledge-lint lint checks knowledge/glossary/rag.md and embedding.md and reports two errors for embedding.md: status 'stable' is not one of the allowed values (current, deprecated), and related link './vectors.md' points to a file that doesn't exist. The run ends with '2 error(s), 0 warning(s) found.' and exit code 1. After the entry is changed to status: current with a related link to ./rag.md, the same command prints 'All checks passed (0 warning(s)).' and exits with 0."
    />
  </Hero>

  <Features
    heading="Who it is for"
    items={[
      {
        title: 'Teams that keep notes in Git',
        body: 'Decisions, processes and glossaries as Markdown files, reviewed in pull requests. knowledge-lint is the check that runs next to the review.',
      },
      {
        title: 'Knowledge bases for AI',
        body: 'It comes from ai-knowledge-template, a knowledge base for chats, RAG and agents. Entries that are overdue for review or carry the wrong type are flagged before anyone relies on them.',
      },
      {
        title: 'Secrets stay encrypted',
        body: 'Secret files must be SOPS-encrypted, and entries are scanned for private keys and API tokens. Nothing is ever decrypted.',
      },
    ]}
  />

  <Facts
    items={[
      { value: '3', label: 'category kinds: entries, SOPS secrets, assets' },
      { value: '2', label: 'commands: lint and clean' },
      { value: '10', label: 'plaintext key markers scanned in every entry' },
      { value: '0 / 1', label: 'exit code for warnings only / any error' },
    ]}
  />

  <section class="how" aria-labelledby="how-heading">
    <h2 id="how-heading">How it works</h2>
    <div class="text">
      <p>
        You declare your categories, entry types and status words in <code>_types.yml</code>.
        {' '}<code>knowledge-lint lint</code> reads it, goes through every folder of the knowledge
        directory and checks it by the kind you declared: Markdown entries, encrypted secrets or
        plain assets. A folder that is not declared is an error. Last, it checks the attachment
        list.
      </p>
      <p>
        Each problem is printed under the file it belongs to. Errors fail the run with exit code 1,
        so a CI job stops; warnings, such as an entry that is due for review, are reported without
        failing it.
      </p>
    </div>
    <Diagram name="how-it-works" format="svg" narrow={{ width: 340, height: 630 }} />
    <div class="links">
      <Button href={url('docs/guides/configuration/')} variant="secondary">Configure _types.yml</Button>
      <Button href={url('docs/reference/rules/')} variant="secondary">Every rule</Button>
      <Button href={url('docs/guides/ci/')} variant="quiet">Run it in CI →</Button>
    </div>
  </section>

  <Quickstart
    lead="Install the binary, declare your categories, run it."
    steps={[
      'Install knowledge-lint from crates.io with <code>cargo install</code>.',
      'Declare your categories in <code>knowledge/_types.yml</code>.',
      'Run <code>knowledge-lint lint</code> and fix what it reports.',
    ]}
  >
    <CodeBlock code={usage} lang="sh" label="Two commands" />
  </Quickstart>

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'What exactly does knowledge-lint check?',
        a: 'Declared categories, required frontmatter fields, allowed status values, overdue last_reviewed dates, broken related links, structurally-valid SOPS secrets, a best-effort scan for plaintext API keys, and every entry in _attachments.yml.',
      },
      {
        q: 'Do I have to use ai-knowledge-template to use this?',
        a: 'No. It was extracted from that project, but every category, type, and status value is declared in your own _types.yml — there is no dependency on it.',
      },
      {
        q: 'Does it ever decrypt my SOPS secrets?',
        a: 'No. The sops_secret check is structural only: it confirms the file parses as YAML with a top-level sops: key, and never needs access to a private key.',
      },
      {
        q: 'Can I rename the frontmatter fields, like title or status?',
        a: 'No, the frontmatter key names are fixed by the spec. Category names, type values, and the status vocabulary itself are configurable in _types.yml.',
      },
      {
        q: 'How does it behave in CI?',
        a: 'knowledge-lint lint exits 1 on any error and 0 when only warnings remain, so it composes directly into a CI job: install the binary with cargo install and run it against your knowledge directory.',
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
  .how {
    max-width: var(--max);
    margin: 0 auto;
    padding: 0 24px 96px;
  }
  h2 {
    margin: 0 0 14px;
    color: var(--heading);
    font-size: 30px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .text {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr));
    gap: 0 48px;
  }
  .text p {
    margin: 0 0 16px;
    font-size: 15.5px;
  }
  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
</style>
